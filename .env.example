# .env.example — copy to .env and fill in real values
# .env files are git-ignored; this example is tracked as a reference.

# --- Auth / JWT ---
# Secret for signing JWTs (HS256). Use a random 256-bit+ value in production.
# For asymmetric signing (RS256/ES256), use JWT_PUBLIC_KEY / JWT_PRIVATE_KEY files instead.
JWT_SECRET=change-me-to-a-random-secret

# Token lifetimes (seconds)
JWT_ACCESS_LIFETIME=900
JWT_REFRESH_LIFETIME=604800

# --- API ---
# Base URL for the backend API
API_BASE_URL=http://localhost:3000/api

# --- External services (examples) ---
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# DATABASE_URL=
# REDIS_URL=
