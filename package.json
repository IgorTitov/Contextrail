{
  "name": "contextrail-template",
  "description": "Context-Optimized Architecture template — hex-modular monolith scaffold for AI-assisted development with structured headers, tiered navigation, and multi-agent coordination.",
  "private": true,
  "version": "0.8.15",
  "packageManager": "pnpm@10.30.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "create-module": "node scripts/checks/create-module.mjs",
    "install:hooks": "node scripts/checks/install-hooks.mjs",
    "spec-check": "node scripts/checks/spec-check.mjs",
    "spec-sync": "node scripts/checks/spec-sync.mjs",
    "backlog-sync": "node scripts/checks/backlog-sync.mjs",
    "product-docs-check": "node scripts/checks/product-docs-check.mjs",
    "design-docs-check": "node scripts/checks/design-docs-check.mjs",
    "architecture-check": "node scripts/checks/architecture-check.mjs",
    "delivery-flow-check": "node scripts/checks/delivery-flow-check.mjs",
    "context:brief": "node scripts/agent-context.mjs",
    "control-plane-check": "node scripts/checks/control-plane-check.mjs",
    "agent-contract:sync": "node scripts/agent-contract/sync.mjs",
    "agent-contract:check": "node scripts/agent-contract/check.mjs",
    "header-check": "node scripts/checks/header-check.mjs",
    "header-fix": "node scripts/checks/header-fix.mjs",
    "readme-check": "node scripts/checks/readme-check.mjs",
    "readme-fix": "node scripts/checks/readme-fix.mjs",
    "capabilities-check": "node scripts/checks/capabilities-sync.mjs --check",
    "modules:fit-check": "node scripts/checks/module-fit-check.mjs",
    "modules:fit-report": "node scripts/checks/module-fit-check.mjs --report",
    "changelog-sync": "node scripts/checks/changelog-sync.mjs",
    "version-bump": "node scripts/checks/version-bump.mjs",
    "test": "pnpm test:all",
    "test:coverage": "c8 --reporter=text --reporter=html node --import ./tests/_setup/no-live-git.mjs scripts/run-tests.mjs tests/unit",
    "test:unit": "node --import ./tests/_setup/no-live-git.mjs scripts/run-tests.mjs tests/unit",
    "test:integration": "node --import ./tests/_setup/no-live-git.mjs scripts/run-tests.mjs tests/integration",
    "test:contract": "node --import ./tests/_setup/no-live-git.mjs scripts/run-tests.mjs tests/contract",
    "test:bdd": "node --import ./tests/_setup/no-live-git.mjs scripts/run-tests.mjs tests/bdd",
    "test:checks": "node --import ./tests/_setup/no-live-git.mjs scripts/run-tests.mjs tests/checks",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:contract && pnpm test:bdd && pnpm test:checks",
    "test:e2e:smoke": "pnpm exec playwright test \"tests/e2e/template-bootstrap.spec.mjs\"",
    "snapshot": "node scripts/merge-snapshot.mjs",
    "mergezip": "node scripts/mergezip.mjs",
    "mergezip:quiet": "node scripts/mergezip.mjs --quiet",
    "mergezip:no-bump": "node scripts/mergezip.mjs --no-bump",
    "test:all:mergezip": "node scripts/testall-mergezip.mjs",
    "e2e": "node scripts/checks/run-e2e.mjs",
    "e2e:visible": "node scripts/checks/run-e2e.mjs --headed",
    "e2e:ui": "pnpm exec playwright test --ui",
    "playwright:install": "pnpm exec playwright install",
    "usm-check": "node scripts/checks/usm-check.mjs",
    "product-data-check": "node scripts/checks/product-data-check.mjs",
    "pre-impl-gate": "node scripts/checks/pre-impl-gate.mjs",
    "pre-commit": "node scripts/checks/pre-commit-runner.mjs",
    "pre-commit:fast": "node scripts/checks/pre-commit-runner.mjs --fast",
    "changelog-compile": "node scripts/checks/changelog-compile.mjs",
    "demo": "node scripts/demo/context-budget-demo.mjs",
    "demo:json": "node scripts/demo/context-budget-demo.mjs --json",
    "claim-check": "node scripts/checks/claim-check.mjs",
    "changeset-size-check": "node scripts/checks/changeset-size-check.mjs",
    "e2e:headed": "node scripts/checks/run-e2e.mjs --headed",
    "e2e:demo": "node scripts/checks/run-e2e.mjs --demo",
    "report:architecture": "node scripts/reports/architecture-report.mjs",
    "report:test-run": "node scripts/reports/test-run-report.mjs",
    "lint": "eslint \"modules/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"apps/**/*.mjs\"",
    "lint:fix": "eslint --fix \"modules/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"apps/**/*.mjs\"",
    "format": "prettier --write \"modules/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"apps/**/*.mjs\" \"*.mjs\"",
    "format:check": "prettier --check \"modules/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"apps/**/*.mjs\" \"*.mjs\"",
    "build": "node scripts/build-single.mjs",
    "build:hosted": "node scripts/build-single.mjs --mode hosted --clean",
    "build:pwa": "node scripts/build-single.mjs --mode pwa --clean",
    "build:local": "node scripts/build-single.mjs --mode local --clean",
    "build:electron": "node scripts/build-single.mjs --mode electron --clean",
    "build:extension": "node scripts/build-single.mjs --mode extension --clean"
  },
  "dependencies": {
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "archiver": "^7.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1"
  },
  "projectPrefix": "contextrail-template",
  "projectPrefixAliases": [],
  "appConfig": {
    "mode": "hosted",
    "features": {
      "pwa": false,
      "offlineCache": false,
      "installPrompt": false
    }
  },
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "brace-expansion": ">=2.0.3"
    }
  }
}
